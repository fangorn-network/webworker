{
  "name": "fangorn-webworker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:r2": "pnpm --filter ./fangorn-r2 dev",
    "dev:gate": "pnpm --filter ./onchain-gate dev",
    "deploy:r2": "pnpm --filter ./fangorn-r2 deploy",
    "deploy:gate": "pnpm --filter ./onchain-gate deploy",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
